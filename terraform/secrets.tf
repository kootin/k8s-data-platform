# Credentials are generated by Terraform and handed to the cluster as a
# Kubernetes Secret, so no password is ever written in the repo.

resource "random_password" "postgres" {
  length  = 24
  special = false
}

resource "random_password" "airflow_admin" {
  length  = 16
  special = false
}

resource "random_password" "airflow_secret_key" {
  length  = 32
  special = false
}

locals {
  pg_user = "platform"
  pg_host = "postgres.${var.namespace}.svc.cluster.local"
}

resource "kubernetes_secret" "platform" {
  metadata {
    name      = "platform-credentials"
    namespace = kubernetes_namespace.platform.metadata[0].name
  }

  data = {
    POSTGRES_USER          = local.pg_user
    POSTGRES_PASSWORD      = random_password.postgres.result
    AIRFLOW_DB_CONN        = "postgresql+psycopg2://${local.pg_user}:${random_password.postgres.result}@${local.pg_host}:5432/airflow"
    WAREHOUSE_DB_URL       = "postgresql://${local.pg_user}:${random_password.postgres.result}@${local.pg_host}:5432/warehouse"
    AIRFLOW_ADMIN_PASSWORD = random_password.airflow_admin.result
    AIRFLOW_SECRET_KEY     = random_password.airflow_secret_key.result
  }
}

# Non-secret settings the pipeline reads at runtime.
resource "kubernetes_config_map" "platform" {
  metadata {
    name      = "platform-config"
    namespace = kubernetes_namespace.platform.metadata[0].name
  }

  data = {
    S3_ENDPOINT_URL    = "http://localstack.${var.namespace}.svc.cluster.local:4566"
    AWS_DEFAULT_REGION = var.aws_region
    RAW_BUCKET         = aws_s3_bucket.raw.bucket
    CURATED_BUCKET     = aws_s3_bucket.curated.bucket
  }
}
